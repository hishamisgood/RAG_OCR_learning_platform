# Copy to .env and fill in your keys. Do NOT put real keys in this file.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LOCAL_LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

GEMINI_API_KEY=        # free key from https://aistudio.google.com (keep billing OFF for $0)
TAVILY_API_KEY=
SERPER_API_KEY=

EMBEDDING_MODEL=BAAI/bge-m3
TOP_K=6
MAX_RETRIES=2
WEB_PROVIDER=tavily     # tavily | serper | none

OCR_PROVIDER=gemini     # gemini | ollama | none
OCR_MODEL=gemini-2.5-flash
LOCAL_OCR_MODEL=qwen2.5vl:3b
OCR_LOCAL_FALLBACK=true
